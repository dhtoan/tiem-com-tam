{
  "name": "tiem-com-tam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "simulate:campaign": "node scripts/simulate-campaign.mjs",
    "fuzz:director": "node scripts/fuzz-director.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.2"
  }
}
